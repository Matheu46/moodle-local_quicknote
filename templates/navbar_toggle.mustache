    @template local_quicknote/navbar_toggle
    @copyright 2026 Matheus Mathias
    @license   http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Navbar toggle button for QuickNote.

    Example context (json):
    {
        "togglelabel": "Toggle QuickNote drawer"
    }
}}
<div class="d-flex align-items-stretch">
    <button
        type="button"
        class="nav-link icon-no-margin border-0 bg-transparent local-quicknote__navbar-toggle"
        data-action="quicknote-toggle"
        aria-expanded="false"
        title="{{togglelabel}} (Alt + Q)"
        aria-label="{{togglelabel}}"
    >
        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
    </button>
</div>
