    Sidebar template for local_quicknote.

    Example context (json):
    {
        "courseid": "2",
        "title": "Notes",
        "placeholder": "Type your note here...",
        "emptytext": "No notes found.",
        "togglelabel": "Open QuickNote",
        "closelabel": "Close",
        "addlabel": "Add note"
    }
}}

<div
    id="local-quicknote-root"
    class="local-quicknote {{positionclass}}"
    data-courseid="{{courseid}}"
    data-pageurl="{{pageurl}}"
    data-pagehash="{{pagehash}}"
    data-pagetitle="{{pagetitle}}"
    data-placeholder="{{placeholder}}"
    data-emptytext="{{emptytext}}"
    data-savingtext="{{savingtext}}"
    data-savedtext="{{savedtext}}"
    data-errortext="{{errortext}}"
    data-updatedlabel="{{updatedlabel}}"
    data-locationlabel="{{locationlabel}}"
    data-highlightlabel="{{highlightlabel}}"
    data-deleteconfirm="{{deleteconfirm}}"
    data-noresultstext="{{noresultstext}}"
    data-closelabel="{{closelabel}}"
    data-deleteimagelabel="{{#str}} screenshot:delete, local_quicknote {{/str}}"
    data-uploadingtext="{{#str}} screenshot:uploading, local_quicknote {{/str}}"
    data-loadingtext="{{#str}} loading, core {{/str}}"
    data-enablevoicedictation="{{enablevoicedictation}}"
    data-voicelabel="{{voicelabel}}"
    data-voicestoplabel="{{voicestoplabel}}"
    data-voicelisteninglabel="{{voicelisteninglabel}}"
    data-voiceendedlabel="{{voiceendedlabel}}"
    data-enablecalendarreminders="{{enablecalendarreminders}}"
    data-reminderlabel="{{reminderlabel}}"
    data-remindertimelabel="{{remindertimelabel}}"
    data-remindersetlabel="{{remindersetlabel}}"
    data-reminderremovelabel="{{reminderremovelabel}}"
    data-voicepermissiondenied="{{#str}} voice:permission_denied, local_quicknote {{/str}}"
>
    <div class="local-quicknote__fab-wrapper">
        <button
            type="button"
            class="local-quicknote__fab-add"
            data-action="add-and-open"
            title="{{addlabel}} (Alt + Q)"
            aria-label="{{addlabel}} (Alt + Q)"
            aria-keyshortcuts="Alt+Q"
        >
            <i class="fa fa-plus" aria-hidden="true"></i>
        </button>

        <button
            type="button"
            class="local-quicknote__toggle"
            data-action="toggle"
            aria-controls="local-quicknote-panel"
            aria-expanded="false"
            title="{{togglelabel}}"
            aria-label="{{togglelabel}}"
        >
            <span class="local-quicknote__toggle-icon local-quicknote__toggle-icon--edit">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
            </span>
            <span class="local-quicknote__toggle-icon local-quicknote__toggle-icon--close">
                {{#pix}} e/cancel, core {{/pix}}
            </span>
        </button>
    </div>

    <aside
        id="local-quicknote-panel"
        class="local-quicknote__panel"
        data-region="panel"
        aria-hidden="true"
    >
        <div id="local-quicknote-a11y-announcer" class="visually-hidden" aria-live="polite"></div>
        <div class="local-quicknote__header">
            <h3 class="local-quicknote__title">{{title}}</h3>
            <button
                type="button"
                class="btn-close p-2"
                data-action="close"
                title="{{closelabel}}"
                aria-label="{{closelabel}}"
            >
            </button>
        </div>


        <div class="local-quicknote__search position-relative">
            <label class="visually-hidden" for="local-quicknote-search">{{#str}} search:placeholder, local_quicknote {{/str}}</label>
            <input
                id="local-quicknote-search"
                type="text"
                class="form-control local-quicknote__search-input"
                data-action="search"
                placeholder="{{#str}} search:placeholder, local_quicknote {{/str}}"
            >
            <button
                type="button"
                class="btn btn-sm btn-link local-quicknote__search-clear"
                data-action="clear-search"
                title="{{#str}} search:clear, local_quicknote {{/str}}"
                aria-label="{{#str}} search:clear, local_quicknote {{/str}}"
                hidden
            >
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
            <i class="fa fa-search local-quicknote__search-icon" aria-hidden="true"></i>
        </div>

        <div class="local-quicknote__notes" data-region="notes-list">
            <p class="local-quicknote__empty">{{emptytext}}</p>
        </div>
        <template data-region="note-template">
            <article class="local-quicknote__note" data-note-key="">
                <div class="local-quicknote__note-actions">
                    <span class="local-quicknote__status" data-region="note-status"></span>
                    <button
                        type="button"
                        class="btn btn-link btn-sm local-quicknote__delete text-danger"
                        data-action="delete-note"
                        data-noteid=""
                        title="{{#str}} note:delete, local_quicknote {{/str}}"
                        aria-label="{{#str}} note:delete, local_quicknote {{/str}}"
                    >
                        <i class="fa fa-trash-o" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="local-quicknote__quote-wrapper" data-region="note-quote-wrapper" hidden>
                    <blockquote class="local-quicknote__quote">
                        <div class="local-quicknote__quote-text" data-region="note-quote"></div>
                    </blockquote>
                    <button
                        type="button"
                        class="local-quicknote__quote-toggle"
                        data-action="toggle-quote"
                        aria-expanded="false"
                        data-more="{{#str}} quote:more, local_quicknote {{/str}}"
                        data-less="{{#str}} quote:less, local_quicknote {{/str}}"
                        hidden
                    >{{#str}} quote:more, local_quicknote {{/str}}</button>
                    <div>
                        <a
                            class="local-quicknote__quote-link"
                            data-region="note-quote-link"
                            href="#"
                            hidden
                        >
                            {{#str}} note:viewintext, local_quicknote {{/str}}
                        </a>
                    </div>
                </div>

                <div class="local-quicknote__meta" data-region="note-location"></div>

                <div class="local-quicknote__textarea-wrapper">
                    <textarea
                        class="local-quicknote__textarea"
                        data-note-key=""
                        placeholder="{{placeholder}}"
                        aria-label="{{placeholder}}"
                    ></textarea>
                    <div class="local-quicknote__textarea-actions">
                        <button
                            type="button"
                            class="btn btn-sm btn-link local-quicknote__voice-btn d-none"
                            data-action="voice-dictate"
                            title="{{voicelabel}}"
                            aria-label="{{voicelabel}}"
                            aria-pressed="false"
                        >
                            <i class="fa-solid fa-microphone" aria-hidden="true"></i>
                        </button>
                        {{#enablecalendarreminders}}
                        <button
                            type="button"
                            class="btn btn-sm btn-link local-quicknote__reminder-btn d-none"
                            data-action="toggle-reminder"
                            title="{{reminderlabel}}"
                            aria-label="{{reminderlabel}}"
                            aria-expanded="false"
                        >
                            <i class="fa-regular fa-bell" aria-hidden="true"></i>
                        </button>
                        {{/enablecalendarreminders}}
                        <button
                            type="button"
                            class="btn btn-sm btn-link local-quicknote__copy-btn"
                            data-action="copy-note"
                            title="{{#str}} copy, core {{/str}}"
                            aria-label="{{#str}} copy, core {{/str}}"
                        >
                            <i class="fa-regular fa-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                {{#enablecalendarreminders}}
                <div class="local-quicknote__reminder-popover d-none" data-region="reminder-popover">
                    <div class="d-flex align-items-center gap-1 p-1">
                        <input
                            type="datetime-local"
                            class="form-control form-control-sm local-quicknote__reminder-input"
                            data-region="reminder-input"
                            aria-label="{{remindertimelabel}}"
                        >
                        <button
                            type="button"
                            class="btn btn-sm btn-primary py-0 px-2 local-quicknote__reminder-save-btn"
                            data-action="save-reminder"
                            title="{{#str}} save, core {{/str}}"
                            aria-label="{{#str}} save, core {{/str}}"
                        >
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-secondary py-0 px-2 local-quicknote__reminder-cancel-btn"
                            data-action="cancel-reminder"
                            title="{{#str}} cancel, core {{/str}}"
                            aria-label="{{#str}} cancel, core {{/str}}"
                        >
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="local-quicknote__reminder-badge-wrapper d-none" data-region="reminder-badge-wrapper">
                    <span class="badge text-bg-light border local-quicknote__reminder-badge d-inline-flex align-items-center gap-1 mt-1">
                        <i class="fa-regular fa-bell text-primary" aria-hidden="true"></i>
                        <span class="local-quicknote__reminder-text" data-region="reminder-text"></span>
                        <button
                            type="button"
                            class="btn-close btn-close-sm ms-1"
                            data-action="remove-reminder"
                            title="{{reminderremovelabel}}"
                            aria-label="{{reminderremovelabel}}"
                        ></button>
                    </span>
                </div>
                {{/enablecalendarreminders}}

                <div class="local-quicknote__screenshots" data-region="screenshots"></div>
                {{#enablescreenshots}}
                <p class="local-quicknote__paste-hint">{{#str}} screenshot:pastehint, local_quicknote {{/str}}</p>
                {{/enablescreenshots}}
            </article>
        </template>

        <div class="local-quicknote__footer mt-auto p-3 pb-0 border-top d-flex flex-column align-items-center">
            <button type="button" class="btn btn-primary mb-2" data-action="add" title="{{addlabel}} (Alt + Q)" aria-keyshortcuts="Alt+Q">
                {{addlabel}}
            </button>
            <a href="{{config.wwwroot}}/local/quicknote/view.php" class="btn btn-link">
                {{#str}} viewnotescenter, local_quicknote {{/str}}
            </a>
        </div>
    </aside>
</div>
