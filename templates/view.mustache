    View template for local_quicknote.

    Example context (json):
    {
        "filterbycourse": "Filter by course",
        "allcourses": "All courses",
        "nonotesfound": "No notes found.",
        "searchnotes": "Search notes...",
        "search": "Search",
        "exportpdf": "Export to PDF",
        "hasnotestosearch": true,
        "hasnotes": true,
        "coursefilter": 0,
        "searchterm": "",
        "config": {
            "wwwroot": "http://localhost/moodle"
        },
        "courses": [
            {
                "id": 1,
                "fullname": "Digital Systems",
                "selected": false
            }
        ],
        "notes": [
            {
                "coursefullname": "Digital Systems",
                "content": "Remember to review logic gates for the exam.",
                "timeupdated": "May 28, 2026, 14:03",
                "quote": "The NAND gate is universal.",
                "quoteurl": "http://localhost/moodle/mod/page/view.php?id=2"
            }
        ]
    }
}}

<div class="local-quicknote-center">
    <div id="quicknote-a11y-announcer" class="sr-only" aria-live="polite"></div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <form method="GET" action="{{config.wwwroot}}/local/quicknote/view.php" class="flex-grow-1">
            <div class="form-group row align-items-center mb-0">
                <label for="coursefilter" class="col-sm-3 col-md-2 col-form-label font-weight-bold">{{filterbycourse}}</label>
                <div class="col-sm-9 col-md-4 col-lg-4 mb-2 mb-md-0">
                    <select name="coursefilter" id="coursefilter" class="custom-select form-select">
                        <option value="0">{{allcourses}}</option>
                        {{#courses}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{fullname}}</option>
                        {{/courses}}
                    </select>
                </div>
                {{#hasnotestosearch}}
                <div class="col-sm-12 col-md-6 col-lg-6">
                    <div class="input-group">
                        <label class="sr-only" for="searchterm">{{searchnotes}}</label>
                        <div class="local-quicknote-center__search-wrapper">
                            <input type="text" name="searchterm" id="searchterm" class="form-control local-quicknote-center__search-input" placeholder="{{searchnotes}}" value="{{searchterm}}">
                            <button type="button" class="btn btn-sm btn-link local-quicknote-center__search-clear" id="clearsearch" title="{{#str}} search:clear, local_quicknote {{/str}}" aria-label="{{#str}} search:clear, local_quicknote {{/str}}" {{^searchterm}}hidden{{/searchterm}}>
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="input-group-append">
                            <button class="btn btn-primary" type="submit">
                                <i class="fa fa-search mr-1" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
                {{/hasnotestosearch}}
            </div>
        </form>

        <div class="w-100 mt-3 d-flex flex-wrap justify-content-between align-items-center " data-region="quicknote-exports">
            {{#hasnotes}}
            <div class="d-flex flex-wrap ">
                <a href="{{config.wwwroot}}/local/quicknote/view.php?export=md&amp;coursefilter={{coursefilter}}&amp;searchterm={{searchterm}}" class="btn btn-outline-secondary text-nowrap mr-2">
                    <i class="fa fa-file-text-o mr-1" aria-hidden="true"></i>{{exportmd}}
                </a>
                <a href="{{config.wwwroot}}/local/quicknote/view.php?export=pdf&amp;coursefilter={{coursefilter}}&amp;searchterm={{searchterm}}" class="btn btn-secondary text-nowrap">
                    <i class="fa fa-file-pdf-o mr-1" aria-hidden="true"></i>{{exportpdf}}
                </a>
            </div>
            <button type="button" class="btn btn-link text-nowrap" id="toggle-bulk-actions">
                <i class="fa fa-tasks mr-1" aria-hidden="true"></i>{{#str}} bulkactions, core {{/str}}
            </button>
            {{/hasnotes}}
        </div>
    </div>

    <div class="row" data-region="quicknote-results">
        {{#notes}}
        <div class="col-12 col-md-6 col-xl-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light border-bottom-0 d-flex align-items-center font-weight-bold">
                    <div class="form-check local-quicknote-bulk-check mr-2 d-none mb-0">
                        <input type="checkbox" class="form-check-input local-quicknote-card-select" data-id="{{id}}" aria-label="{{#str}} selectnote, local_quicknote {{/str}}">
                    </div>
                    <span class="text-truncate" title="{{coursefullname}}">{{coursefullname}}</span>
                </div>
                <div class="card-body local-quicknote-center__card-body">
                    {{#quote}}
                    <blockquote class="blockquote border-left border-primary pl-3 mb-3 local-quicknote-center__quote">
                        <p class="mb-1 font-italic text-muted local-quicknote-center__quote-text">{{quote}}</p>
                        {{#quoteurl}}
                        <footer class="blockquote-footer mt-1">
                            <a href="{{quoteurl}}" target="_blank" class="small">{{#str}} note:viewintext, local_quicknote {{/str}}</a>
                        </footer>
                        {{/quoteurl}}
                    </blockquote>
                    {{/quote}}
                    {{^quote}}
                        {{#url}}
                        <div class="mb-3">
                            <a href="{{url}}" target="_blank" class="small"><i class="fa fa-external-link mr-1"></i>{{#str}} note:viewintext, local_quicknote {{/str}}</a>
                        </div>
                        {{/url}}
                    {{/quote}}
                    <p class="card-text local-quicknote-center__content">{{content}}</p>

                    {{#screenshots.0}}
                    <div class="local-quicknote__screenshots mt-3" data-region="screenshots">
                        {{#screenshots}}
                            <figure class="local-quicknote__screenshot">
                                <a href="{{url}}" target="_blank" rel="noopener">
                                    <img src="{{url}}" alt="{{filename}}" loading="lazy">
                                </a>
                                <button type="button" class="btn btn-sm btn-danger local-quicknote__screenshot-delete" data-action="delete-screenshot" data-fileid="{{id}}" title="{{#str}} screenshot:delete, local_quicknote {{/str}}" aria-label="{{#str}} screenshot:delete, local_quicknote {{/str}}">
                                    &times;
                                </button>
                            </figure>
                        {{/screenshots}}
                    </div>
                    {{/screenshots.0}}
                </div>
                <div class="card-footer bg-light border-top-0 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">
                        <i class="fa fa-clock-o mr-1" aria-hidden="true"></i>
                        <span class="sr-only">{{#str}} lastmodified, core {{/str}}:</span>
                        {{timeupdated}}
                    </span>
                    <button type="button" class="btn btn-sm btn-link text-danger local-quicknote-delete-btn" data-action="delete" data-id="{{id}}" title="{{#str}} note:delete, local_quicknote {{/str}}">
                        <i class="fa fa-trash-o" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
        {{/notes}}
        {{^notes}}
        <div class="col-12">
            <div class="alert alert-info">
                {{#hasnotestosearch}}
                    {{noresultstext}}
                {{/hasnotestosearch}}
                {{^hasnotestosearch}}
                    {{nonotesfound}}
                {{/hasnotestosearch}}
            </div>
        </div>
        {{/notes}}
    </div>

    <div class="mt-4 mb-4 d-flex justify-content-center" data-region="quicknote-pagination">
        {{#pagingbar}}
        {{{pagingbar}}}
        {{/pagingbar}}
    </div>
</div>

<div class="local-quicknote-bulk-bar d-none shadow" id="quicknote-bulk-bar">
    <div class="container-fluid d-flex flex-nowrap justify-content-between align-items-center">
        <div class="d-flex align-items-center text-nowrap">
            <div class="form-check mr-md-3 mb-0">
                <input type="checkbox" class="form-check-input" id="quicknote-bulk-select-all" aria-label="{{#str}} selectall, core {{/str}}">
                <label class="form-check-label d-none d-md-inline" for="quicknote-bulk-select-all">{{#str}} selectall, core {{/str}}</label>
            </div>
            <span class="badge badge-primary" id="quicknote-bulk-count">0</span>
        </div>
        <div class="d-flex align-items-center flex-nowrap ">
            <button type="button" class="btn btn-outline-secondary text-nowrap mr-2" id="quicknote-bulk-export-md" disabled title="{{exportmd}}" aria-label="{{exportmd}}">
                <i class="fa fa-file-text-o m-0 mr-md-1" aria-hidden="true"></i><span class="d-none d-md-inline">{{exportmd}}</span>
            </button>
            <button type="button" class="btn btn-secondary text-nowrap mr-2" id="quicknote-bulk-export-pdf" disabled title="{{exportpdf}}" aria-label="{{exportpdf}}">
                <i class="fa fa-file-pdf-o m-0 mr-md-1" aria-hidden="true"></i><span class="d-none d-md-inline">{{exportpdf}}</span>
            </button>
            <button type="button" class="btn btn-danger text-nowrap" id="quicknote-bulk-delete" disabled title="{{#str}} deleteselected, core {{/str}}" aria-label="{{#str}} deleteselected, core {{/str}}">
                <i class="fa fa-trash-o m-0 mr-md-1" aria-hidden="true"></i><span class="d-none d-md-inline">{{#str}} deleteselected, core {{/str}}</span>
            </button>
            <button type="button" class="btn btn-link text-decoration-none text-secondary ml-1 ml-md-2 p-1" id="quicknote-bulk-close" aria-label="{{#str}} closebulkactions, local_quicknote {{/str}}" title="{{#str}} closebulkactions, local_quicknote {{/str}}">
                <i class="fa fa-times fa-lg m-0" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>

{{#js}}
require(['local_quicknote/view'], function(view) {
    view.init();
});
{{/js}}
